# Local-only benchmark or tuning outputs.
# Curated JSON files under artifacts/ are kept as research records.
artifacts/tmp/
artifacts/local/
artifacts/*.local.json
artifacts/*-local.json

# Local phase-transition research outputs.
# The deterministic fixture remains available for CI and reproducibility.
/artifacts/phase-transition/smoke/
/artifacts/phase-transition/diversity-smoke/
/artifacts/phase-transition/pilot/
/artifacts/phase-transition/pilot-v2/
/artifacts/phase-transition/robustness-v1/
/artifacts/phase-transition/independent-confirmation-v2/
/artifacts/phase-transition/search-profile-dependence-v1/
/artifacts/phase-transition/search-profile-generalization-v2/
/artifacts/phase-transition/d3-reversal-replication-v1/
/artifacts/phase-transition/archive/

# PBAI-P4 full observations are preserved in versioned evidence archives.
/artifacts/pbai-p4/development/
/artifacts/pbai-p4/validation/
/artifacts/pbai-p4/holdout/

# PBAI-P5 complete raw observations are stored in final-evidence.tar.gz.
/artifacts/pbai-p5/run/

# PBAI-P6 raw execution is archived with a SHA-256 inventory after completion.
/artifacts/pbai-p6/run/

# PBAI-P7 raw evidence is archived after the consume-once execution.
/artifacts/pbai-p7/run/

# PBAI-P8 consume-once raw execution is archived after completion.
/artifacts/pbai-p8/run/

# PBAI-P9 complete raw evidence is archived after execution.
/artifacts/pbai-p9/run/
/artifacts/pbai-p9/browser-ci/

/artifacts/pbai-p10/run/

/artifacts/pbai-p11/run/
/artifacts/pbai-p11/final/
