{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bao-game-record-ingest",
  "main": "src/entry.mjs",
  "compatibility_date": "2026-09-16",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "bao-data.cultivationdata.net",
      "custom_domain": true
    }
  ],
  "vars": {
    "COLLECTION_ENABLED": "false",
    "ALLOWED_ORIGINS": "https://bao-la-kiswahili.cultivationdata.net,https://cdn-ts.pages.dev",
    "FETCH_METADATA_CROSS_SITE_ORIGINS": "https://cdn-ts.pages.dev",
    "TURNSTILE_HOSTNAMES": "bao-la-kiswahili.cultivationdata.net,cdn-ts.pages.dev",
    "MAX_REQUEST_BYTES": "65536",
    "MAX_RECORD_BYTES": "49152",
    "MAX_PLIES": "384",
    "MAX_ACCEPTED_PER_UTC_DAY": "500"
  },
  "r2_buckets": [
    {
      "binding": "GAME_RECORDS",
      "bucket_name": "bao-game-record-contributions"
    }
  ],
  "ratelimits": [
    {
      "name": "PER_CLIENT_RATE_LIMITER",
      "namespace_id": "26091601",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "LOCATION_ACCEPT_RATE_LIMITER",
      "namespace_id": "26091602",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ]
}
