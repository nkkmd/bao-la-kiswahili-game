{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nkkmd/bao-la-kiswahili-game/schemas/position-typology-observation.schema.json",
  "title": "Bao position-typology observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ply", "player", "phase", "turn", "terminal", "winner", "reason", "state", "identity", "features"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "gameId": {"type": "string", "minLength": 1},
    "conditionId": {"type": "string", "minLength": 1},
    "seed": {"type": ["integer", "string"]},
    "ply": {"type": "integer", "minimum": 0},
    "player": {"type": "integer", "enum": [0, 1]},
    "phase": {"type": "string", "enum": ["namua", "mtaji"]},
    "turn": {"type": "integer", "minimum": 1},
    "terminal": {"type": "boolean"},
    "winner": {"type": ["integer", "null"], "enum": [0, 1, null]},
    "reason": {"type": "string"},
    "state": {"$ref": "#/$defs/state"},
    "identity": {"$ref": "#/$defs/identity"},
    "features": {"$ref": "#/$defs/features"}
  },
  "$defs": {
    "pitRow": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0},
      "minItems": 8,
      "maxItems": 8
    },
    "playerRows": {
      "type": "array",
      "items": {"$ref": "#/$defs/pitRow"},
      "minItems": 2,
      "maxItems": 2
    },
    "integerPair": {
      "type": "array",
      "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}],
      "minItems": 2,
      "maxItems": 2
    },
    "booleanPair": {
      "type": "array",
      "prefixItems": [{"type": "boolean"}, {"type": "boolean"}],
      "minItems": 2,
      "maxItems": 2
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pits", "reserve", "houseOwned", "pending"],
      "properties": {
        "pits": {
          "type": "array",
          "items": {"$ref": "#/$defs/playerRows"},
          "minItems": 2,
          "maxItems": 2
        },
        "reserve": {"$ref": "#/$defs/integerPair"},
        "houseOwned": {"$ref": "#/$defs/booleanPair"},
        "pending": {"$ref": "#/$defs/integerPair"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["historicalStateHash", "ruleStateKey", "seatCanonicalKey", "seatCanonicalTransform"],
      "properties": {
        "historicalStateHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "ruleStateKey": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "seatCanonicalKey": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "seatCanonicalTransform": {"type": "string", "enum": ["direct", "seat-swap"]}
      }
    },
    "sideFeatures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reserve", "houseOwned", "nyumbaSeeds", "boardSeeds", "frontSeeds", "backSeeds",
        "occupiedPits", "frontOccupied", "backOccupied", "reusablePits", "frontConnections",
        "legalMoveCount", "captureMoveCount", "forcedCapture", "maxPitSeeds", "pitSeedVariance",
        "seedConcentration", "maxCapturableSeeds", "meanCapturableSeeds", "maxCaptureEvents",
        "meanCaptureEvents", "maxRelayEvents", "meanRelayEvents", "maxChainEvents", "meanChainEvents"
      ],
      "properties": {
        "reserve": {"type": "integer", "minimum": 0},
        "houseOwned": {"type": "boolean"},
        "nyumbaSeeds": {"type": "integer", "minimum": 0},
        "boardSeeds": {"type": "integer", "minimum": 0},
        "frontSeeds": {"type": "integer", "minimum": 0},
        "backSeeds": {"type": "integer", "minimum": 0},
        "occupiedPits": {"type": "integer", "minimum": 0, "maximum": 16},
        "frontOccupied": {"type": "integer", "minimum": 0, "maximum": 8},
        "backOccupied": {"type": "integer", "minimum": 0, "maximum": 8},
        "reusablePits": {"type": "integer", "minimum": 0, "maximum": 16},
        "frontConnections": {"type": "integer", "minimum": 0, "maximum": 7},
        "legalMoveCount": {"type": "integer", "minimum": 0},
        "captureMoveCount": {"type": "integer", "minimum": 0},
        "forcedCapture": {"type": "boolean"},
        "maxPitSeeds": {"type": "integer", "minimum": 0},
        "pitSeedVariance": {"type": "number", "minimum": 0},
        "seedConcentration": {"type": "number", "minimum": 0, "maximum": 1},
        "maxCapturableSeeds": {"type": "number", "minimum": 0},
        "meanCapturableSeeds": {"type": "number", "minimum": 0},
        "maxCaptureEvents": {"type": "number", "minimum": 0},
        "meanCaptureEvents": {"type": "number", "minimum": 0},
        "maxRelayEvents": {"type": "number", "minimum": 0},
        "meanRelayEvents": {"type": "number", "minimum": 0},
        "maxChainEvents": {"type": "number", "minimum": 0},
        "meanChainEvents": {"type": "number", "minimum": 0}
      }
    },
    "difference": {
      "type": "object",
      "additionalProperties": {"type": "number"}
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "opponent", "difference", "global"],
      "properties": {
        "actor": {"$ref": "#/$defs/sideFeatures"},
        "opponent": {"$ref": "#/$defs/sideFeatures"},
        "difference": {"$ref": "#/$defs/difference"},
        "global": {
          "type": "object",
          "additionalProperties": false,
          "required": ["boardSeedCount", "nonEmptyPitCount"],
          "properties": {
            "boardSeedCount": {"type": "integer", "minimum": 0},
            "nonEmptyPitCount": {"type": "integer", "minimum": 0, "maximum": 32}
          }
        }
      }
    }
  }
}
