    "legalReplyCountBin": {
      "1": "count == 1",
      "2": "count == 2",
      "3-4": "3 <= count <= 4",
      "5+": "count >= 5"
    },
    "referenceDefenseMaintainedFraction": "referenceDefenseMaintainedCount / legalReplyCount, defined only when legalReplyCount > 0",
    "referenceDefenseMaintainedFractionBin": {
      "(0,0.25]": "0 < fraction <= 0.25",
      "(0.25,0.5]": "0.25 < fraction <= 0.5"
    },
    "firstReplyReferenceErrorProbabilityBin": {
      "0": "probability == 0",
      "(0,1/3]": "0 < probability <= 1/3",
      "(1/3,2/3]": "1/3 < probability <= 2/3",
      "(2/3,1]": "2/3 < probability <= 1"
    },
    "actorReserve": "rawState.reserve[rawState.player]",
    "actorReserveBin": {
      "0": "reserve == 0",
      "1-4": "1 <= reserve <= 4",
      "5+": "reserve >= 5"
    },
    "actorHouseOwned": "Boolean(rawState.houseOwned[rawState.player])",
    "actorReusablePits": "count of the actor's 16 raw pits whose seed count is >= 2",
    "actorReusablePitsBin": {
      "0-2": "0 <= count <= 2",
      "3-5": "3 <= count <= 5",
      "6+": "count >= 6"
    },
    "actorFrontOccupied": "count of the actor's eight engine FRONT-row raw pits whose seed count is > 0",
    "actorFrontOccupiedBin": {
      "0-3": "0 <= count <= 3",
      "4-5": "4 <= count <= 5",
      "6+": "count >= 6"
    }
