    canonicalRepresentativeRule:"lexicographically minimum authoritative RAW state serialization within orbit generated only by validated applicable transforms",
    standardStartReachability:{
      initialRawStatePreservationByTransform:initialPreservation,
      independentReachabilityClosureProofImplemented:standardStartClosureProofImplemented,
      standardStartReachablePopulationDedupEligible,
    },
  };
}
function compactSelected(selected) {
  return Object.fromEntries(Object.entries(selected).map(([s, rows]) => [s, rows.map((r)=>({seed:r.seed,ply:r.ply,stateKey:r.stateKey,openingPrefixSha256:r.openingPrefixSha256}))]));
}

function main() {
  const oi = process.argv.indexOf("--output");
  ensure(oi >= 0, "--output required");
  const output = path.resolve(process.argv[oi+1]);
  const spec=load(SPEC_PATH), contract=load(CONTRACT_PATH), firewall=load(FIREWALL_PATH), rule=load(RULE_PATH), auth=load(AUTH_PATH), stage1=load(STAGE1_RESULT_PATH);
  verifyAuthorization(spec, auth);
  ensure(contract.scientificCandidates.map((x)=>x.candidateId).join(",") === spec.candidateIds.join(","), "candidate set drift");
  ensure(rule.stageId === spec.stageId && firewall.stageId === spec.stageId, "Stage 2 contract identity mismatch");

  const pop=materializePopulation(spec, firewall, stage1), selected=pop.selected;
  const targets=[
    ["C00-overall",T.IDS.IDENTITY,["namua","mtaji","mtaji-houseless"]],
    ["C01-houseless",T.IDS.NEGATIVE_LR_NO_DIRECTION,["mtaji-houseless"]],
    ["T01-namua",T.IDS.SEAT_SWAP,["namua"]],
    ["T01-mtaji",T.IDS.SEAT_SWAP,["mtaji"]],
    ["T01-mtaji-houseless",T.IDS.SEAT_SWAP,["mtaji-houseless"]],
    ["T01-overall",T.IDS.SEAT_SWAP,["namua","mtaji","mtaji-houseless"]],
    ["T02-houseless",T.IDS.LR_MTAJI_HOUSELESS,["mtaji-houseless"]],
    ["T03-houseless",T.IDS.SEAT_SWAP_LR_MTAJI_HOUSELESS,["mtaji-houseless"]],
  ];
  const measurements={};
  for (const [label,id,strata] of targets) measurements[label]=measure(id,strata,selected,spec.localGraph.depth);
  const summaries=Object.fromEntries(Object.entries(measurements).map(([label,row])=>[label,{
    candidateId:row.candidateId,strata:row.strata,rootCount:row.rootCount,sourceGraph:row.sourceGraph,targetGraph:row.targetGraph,
    gateMismatchCounts:row.gateMismatchCounts,totalMismatchCount:row.totalMismatchCount
  }]));
  const rootCounts=Object.fromEntries(Object.entries(selected).map(([k,v])=>[k,v.length]));
  const localGuardHits=Object.values(measurements).reduce((n,r)=>n+r.sourceGraph.runtimeGuardHits+r.targetGraph.runtimeGuardHits,0);
  const g1=Object.values(rootCounts).every((n)=>n===spec.population.targetRootsPerStratum)
    && Object.values(pop.selectedOverlap).every((n)=>n===0)
    && pop.internalUniquePrefixCount===pop.selectedRows.length
    && pop.internalUniqueRawCount===pop.selectedRows.length;
  const gates={"S2-G1":g1,"S2-G2":pop.trajectoryGuardHitsBeforeSelection===0&&localGuardHits===0,
    "S2-G3":measurements["C00-overall"].totalMismatchCount===0,"S2-G4":measurements["C01-houseless"].totalMismatchCount>0,
    "S2-G5":null,"S2-G6":true};
  const labelByCandidate={
    [T.IDS.SEAT_SWAP]:"T01-overall",
    [T.IDS.LR_MTAJI_HOUSELESS]:"T02-houseless",
    [T.IDS.SEAT_SWAP_LR_MTAJI_HOUSELESS]:"T03-houseless",
  };
  const preIndependentAllGlobal=Object.entries(gates).filter(([k])=>k!=="S2-G5").every(([,v])=>v===true);
  const prelimValidated=preIndependentAllGlobal ? spec.candidateIds.filter((id)=>measurements[labelByCandidate[id]].totalMismatchCount===0) : [];
  const canonicalization=canonicalizationDiagnostics(selected,spec.localGraph.depth,measurements,prelimValidated);
  const measurementSha256=hashCanonical(summaries);
  const decisionInputs={
    selectionSha256:pop.selectionSha256, measurementSha256, rootCounts, selectedOverlap:pop.selectedOverlap,
    internalUniquePrefixCount:pop.internalUniquePrefixCount, internalUniqueRawCount:pop.internalUniqueRawCount,
    trajectoryGuardHitsBeforeSelection:pop.trajectoryGuardHitsBeforeSelection, globalGates:gates,
    candidateMismatchCounts:Object.fromEntries(spec.candidateIds.map((id)=>[id,measurements[labelByCandidate[id]].totalMismatchCount])),
    canonicalization,
  };
  const result={
    schemaVersion:1,programLabel:"G2-03",researchGeneration:"Research Generation 2",studyId:spec.studyId,stageId:spec.stageId,
    stageRole:spec.stageRole,formalConfirmationAuthorized:true,scientificInferenceAuthorized:true,
    hashes:{specSha256:sha256File(SPEC_PATH),candidateContractSha256:sha256File(CONTRACT_PATH),firewallSha256:sha256File(FIREWALL_PATH),
      decisionRuleSha256:sha256File(RULE_PATH),authorizationSha256:sha256File(AUTH_PATH)},
    population:{seedBlock:spec.population.seedBlock,targetRootsPerStratum:spec.population.targetRootsPerStratum,
      generatedTrajectoryCount:pop.generated.length,trajectoryGuardHitsBeforeSelection:pop.trajectoryGuardHitsBeforeSelection,
      excludedByFirewall:pop.excludedByFirewall,selectedOverlap:pop.selectedOverlap,selectedRootCounts:rootCounts,
      selectedRoots:compactSelected(selected),selectionSha256:pop.selectionSha256,
      internalUniquePrefixCount:pop.internalUniquePrefixCount,internalUniqueRawCount:pop.internalUniqueRawCount},
    measurements,measurementSha256,preIndependentGlobalGates:gates,preliminaryValidatedCandidateIds:prelimValidated,
    canonicalizationDiagnostics:canonicalization,decisionInputSha256:hashCanonical(decisionInputs),
    finalCandidateDecisionsAuthorized:false,finalStudyDecisionAuthorized:false,finalCanonicalizationDecisionAuthorized:false,
    independentVerificationRequired:true
  };
  fs.mkdirSync(path.dirname(output),{recursive:true});
  fs.writeFileSync(output,`${JSON.stringify(result,null,2)}\n`,"utf8");
  process.stdout.write(`${JSON.stringify({studyId:result.studyId,stageId:result.stageId,selectionSha256:pop.selectionSha256,
    selectedRootCounts:rootCounts,measurementSha256,preIndependentGlobalGates:gates,
    candidateMismatchCounts:decisionInputs.candidateMismatchCounts,canonicalizationDiagnostics:canonicalization,
    decisionInputSha256:result.decisionInputSha256},null,2)}\n`);
  ensure(preIndependentAllGlobal, "Stage 2 pre-independent global gates failed");
}
if (require.main===module) main();
