  const formalResult={schemaVersion:1,programLabel:"G2-03",researchGeneration:"Research Generation 2",studyId:spec.studyId,stageId:spec.stageId,formalDecision:studyDecision,globalGates:gates,candidateDecisions,validatedCandidateIds:validated,formalCandidateMeasurements:Object.fromEntries(spec.candidateIds.map((id)=>[id,{scopeLabel:labelById[id],rootCount:measurements[labelById[id]].rootCount,totalMismatchCount:measurements[labelById[id]].totalMismatchCount,gateMismatchCounts:measurements[labelById[id]].gateMismatchCounts}])),controls:{identityOverallMismatchCount:measurements["C00-overall"].totalMismatchCount,negativeControlHouselessMismatchCount:measurements["C01-houseless"].totalMismatchCount},population:{seedBlock:spec.population.seedBlock,selectedRootCounts:rootCounts,selectionSha256:pop.selectionSha256,stage1SelectedOverlap:pop.selectedOverlap,internalUniqueOpeningPrefixes:pop.internalUniquePrefixCount,internalUniqueRawStates:pop.internalUniqueRawCount},hashes:{specSha256:shaFile(SPEC_PATH),candidateContractSha256:shaFile(CONTRACT_PATH),firewallSha256:shaFile(FIREWALL_PATH),decisionRuleSha256:shaFile(RULE_PATH),authorizationSha256:shaFile(AUTH_PATH),measurementSha256,decisionInputSha256:preDecisionHash},independentVerification:{passed:allGlobal,comparisons},canonicalization:{semanticDomainDecision:semanticCanonicalizationDecision,validatedTransformIdsUsed:validated,representativeRule:canon.canonicalRepresentativeRule,orbitDiagnostics:{evaluatedSourceGraph:canon.evaluatedSourceGraph,canonicalOrbitCount:canon.canonicalOrbitCount,maxOrbitSize:canon.maxOrbitSize,gateMismatchCounts:canon.gateMismatchCounts,allSemanticDomainGatesPass:canon.allSemanticDomainGatesPass},standardStartReachablePopulationDedupDecision,standardStartReachability:canon.standardStartReachability},interpretationBoundary:{boundedValidationOnly:true,standardStartScientificPopulationIdentityMayUseCanonicalization:standardStartPopulationDedupDecision==="AUTHORIZED-WITHIN-FROZEN-DOMAIN",symmetryReducedStateCountingAuthorized:standardStartPopulationDedupDecision==="AUTHORIZED-WITHIN-FROZEN-DOMAIN",retrospectiveSIPOrORISCDecisionChangeAuthorized:false,g2_01_or_g2_02_rescueAuthorized:false,publicAIEngineeringChangeAuthorized:false},noRescueClosure:true};
  fs.mkdirSync(path.dirname(verificationPath),{recursive:true});fs.mkdirSync(path.dirname(resultPath),{recursive:true});
  fs.writeFileSync(verificationPath,`${JSON.stringify(verification,null,2)}\n`,"utf8");fs.writeFileSync(resultPath,`${JSON.stringify(formalResult,null,2)}\n`,"utf8");
  process.stdout.write(`${JSON.stringify({studyId:formalResult.studyId,stageId:formalResult.stageId,formalDecision:studyDecision,globalGates:gates,candidateDecisions,validatedCandidateIds:validated,semanticCanonicalizationDecision,standardStartPopulationDedupDecision,selectionSha256:pop.selectionSha256,measurementSha256,decisionInputSha256:preDecisionHash,comparisons},null,2)}\n`);
  check(allGlobal,"Stage 2 independent verification/global gates failed");
}
if(require.main===module)main();
