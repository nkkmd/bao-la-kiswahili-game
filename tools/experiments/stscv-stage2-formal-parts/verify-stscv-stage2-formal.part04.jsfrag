  const gates={"S2-G1":Object.values(rootCounts).every((n)=>n===spec.population.targetRootsPerStratum)&&Object.values(pop.selectedOverlap).every((n)=>n===0)&&pop.internalUniquePrefixCount===pop.selectedRows.length&&pop.internalUniqueRawCount===pop.selectedRows.length,"S2-G2":pop.trajectoryGuardHitsBeforeSelection===0&&localGuards===0,"S2-G3":measurements["C00-overall"].totalMismatchCount===0,"S2-G4":measurements["C01-houseless"].totalMismatchCount>0,"S2-G5":null,"S2-G6":true};
  const labelById={[T.IDS.SEAT_SWAP]:"T01-overall",[T.IDS.LR_MTAJI_HOUSELESS]:"T02-houseless",[T.IDS.SEAT_SWAP_LR_MTAJI_HOUSELESS]:"T03-houseless"};
  const preAll=Object.entries(gates).filter(([k])=>k!=="S2-G5").every(([,v])=>v===true);
  const prelimValidated=preAll?spec.candidateIds.filter((id)=>measurements[labelById[id]].totalMismatchCount===0):[];
  const canon=canonicalization(selected,spec.localGraph.depth,measurements,prelimValidated),measurementSha256=canonicalHash(summaries);
  const preDecisionInputs={selectionSha256:pop.selectionSha256,measurementSha256,rootCounts,selectedOverlap:pop.selectedOverlap,internalUniquePrefixCount:pop.internalUniquePrefixCount,internalUniqueRawCount:pop.internalUniqueRawCount,trajectoryGuardHitsBeforeSelection:pop.trajectoryGuardHitsBeforeSelection,globalGates:gates,candidateMismatchCounts:Object.fromEntries(spec.candidateIds.map((id)=>[id,measurements[labelById[id]].totalMismatchCount])),canonicalization:canon};
  const preDecisionHash=canonicalHash(preDecisionInputs);

  const productionSummaries=Object.fromEntries(Object.entries(production.measurements).map(([label,row])=>[label,{candidateId:row.candidateId,strata:row.strata,rootCount:row.rootCount,sourceGraph:row.sourceGraph,targetGraph:row.targetGraph,gateMismatchCounts:row.gateMismatchCounts,totalMismatchCount:row.totalMismatchCount}]));
  const comparisons={
    selectionSha256:production.population.selectionSha256===pop.selectionSha256,
    selectedRoots:canonical(production.population.selectedRoots)===canonical(compactSelected(selected)),
    selectedRootCounts:canonical(production.population.selectedRootCounts)===canonical(rootCounts),
    selectedOverlap:canonical(production.population.selectedOverlap)===canonical(pop.selectedOverlap),
    measurementSha256:production.measurementSha256===measurementSha256,
    measurementSummaries:canonical(productionSummaries)===canonical(summaries),
    preIndependentGlobalGates:canonical(production.preIndependentGlobalGates)===canonical(gates),
    canonicalizationDiagnostics:canonical(production.canonicalizationDiagnostics)===canonical(canon),
    decisionInputSha256:production.decisionInputSha256===preDecisionHash,
  };
  gates["S2-G5"]=Object.values(comparisons).every(Boolean);
  const allGlobal=Object.values(gates).every((v)=>v===true);
  const candidateDecisions={};
  for(const id of spec.candidateIds){
    candidateDecisions[id]=!allGlobal?"NON-ESTIMABLE":measurements[labelById[id]].totalMismatchCount===0?"VALIDATED-BOUNDED-ISOMORPHISM":"NOT-VALIDATED";
  }
  const validated=spec.candidateIds.filter((id)=>candidateDecisions[id]==="VALIDATED-BOUNDED-ISOMORPHISM");
  const studyDecision=!allGlobal?"INCONCLUSIVE":validated.length>0?"CONFIRMED":"NOT-CONFIRMED";
  const semanticCanonicalizationDecision=!allGlobal?"NON-ESTIMABLE":validated.length===0||!canon.allSemanticDomainGatesPass?"NOT-AUTHORIZED":"AUTHORIZED-WITHIN-FROZEN-DOMAIN";
  const standardStartPopulationDedupDecision=!allGlobal?"NON-ESTIMABLE":semanticCanonicalizationDecision==="AUTHORIZED-WITHIN-FROZEN-DOMAIN"&&canon.standardStartReachability.standardStartReachablePopulationDedupEligible?"AUTHORIZED-WITHIN-FROZEN-DOMAIN":"NOT-AUTHORIZED";
  const verification={schemaVersion:1,studyId:spec.studyId,stageId:spec.stageId,independentVerification:true,passed:allGlobal,decision:allGlobal?"STSCV-STAGE2-INDEPENDENT-VERIFICATION-PASS":"STSCV-STAGE2-INDEPENDENT-VERIFICATION-BLOCK",hashes:{specSha256:shaFile(SPEC_PATH),candidateContractSha256:shaFile(CONTRACT_PATH),firewallSha256:shaFile(FIREWALL_PATH),decisionRuleSha256:shaFile(RULE_PATH),authorizationSha256:shaFile(AUTH_PATH)},selectionSha256:pop.selectionSha256,measurementSha256,decisionInputSha256:preDecisionHash,selectedRootCounts:rootCounts,globalGates:gates,comparisons,candidateDecisions,studyDecision,semanticCanonicalizationDecision,standardStartPopulationDedupDecision};
