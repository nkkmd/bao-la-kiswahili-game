  const consumed=consumedIdentitySets(fw,stage1), oldSeeds=consumed.seeds, oldPrefixes=consumed.prefixes, oldRaw=consumed.raw;
  const excludedByFirewall={trajectorySeed:0,openingPrefixSha256:0,rawStateKey:0}, rows=[];
  for(const r of generated) {
    if(r.unavailable) continue;
    let blocked=false;
    if(oldSeeds.has(r.seed)){excludedByFirewall.trajectorySeed+=1;blocked=true;}
    if(oldPrefixes.has(r.openingPrefixSha256)){excludedByFirewall.openingPrefixSha256+=1;blocked=true;}
    if(oldRaw.has(r.stateKey)){excludedByFirewall.rawStateKey+=1;blocked=true;}
    if(!blocked) rows.push(r);
  }
  rows.sort((a,b)=>a.seed-b.seed);
  const selected={namua:[],mtaji:[],"mtaji-houseless":[]}, usedPrefix=new Set(), usedRaw=new Set();
  for(const r of rows) {
    if(selected[r.stratum].length>=spec.population.targetRootsPerStratum) continue;
    if(usedPrefix.has(r.openingPrefixSha256)||usedRaw.has(r.stateKey)) continue;
    usedPrefix.add(r.openingPrefixSha256); usedRaw.add(r.stateKey); selected[r.stratum].push(r);
    if(Object.values(selected).every((x)=>x.length>=spec.population.targetRootsPerStratum)) break;
  }
  const chosen=Object.values(selected).flat();
  const overlap={trajectorySeed:chosen.filter((r)=>oldSeeds.has(r.seed)).length,openingPrefixSha256:chosen.filter((r)=>oldPrefixes.has(r.openingPrefixSha256)).length,rawStateKey:chosen.filter((r)=>oldRaw.has(r.stateKey)).length};
  return {generated,selected,selectedRows:chosen,excludedByFirewall,selectedOverlap:overlap,
    selectionSha256:linesHash(chosen.map((r)=>`${r.stratum}|${r.seed}|${r.ply}|${r.openingPrefixSha256}|${r.stateKey}`)),
    trajectoryGuardHitsBeforeSelection:generated.filter((r)=>r.runtimeGuardHitBeforeSelection).length,
    internalUniquePrefixCount:new Set(chosen.map((r)=>r.openingPrefixSha256)).size,
    internalUniqueRawCount:new Set(chosen.map((r)=>r.stateKey)).size};
}
function graph(roots,depth) {
  const states=new Map(), levels=new Map(), queue=[], edges=new Map(); let runtimeGuardHits=0;
  const add=(state,level)=>{R.assertStudyState(state);const key=R.key(state);if(!states.has(key))states.set(key,copied(state));if(!levels.has(key)||level<levels.get(key)){levels.set(key,level);queue.push(key);}return key;};
  for(const root of roots) add(root.state,0);
  while(queue.length){
    const sourceKey=queue.shift(),level=levels.get(sourceKey),state=states.get(sourceKey);
    if(state.winner!==null||level>=depth) continue;
    for(const move of E.moveVariants(state)){
      const next=E.applyMove(state,move).state;
      if(next.reason==="relay-limit"){runtimeGuardHits+=1;continue;}
      const targetKey=add(next,level+1),moveKey=R.moveIdentity(move);
      edges.set(`${sourceKey}|${moveKey}|${targetKey}`,{sourceKey,targetKey,move:copied(move),moveKey});
    }
  }
  return {states,levels,edges,runtimeGuardHits};
}
function swaps(id){return id===T.IDS.SEAT_SWAP||id===T.IDS.SEAT_SWAP_LR_MTAJI_HOUSELESS;}
function pair(p,s){return s?[p[1],p[0]]:[p[0],p[1]];}
function measure(id,strata,selected,depth){
  const roots=strata.flatMap((s)=>selected[s]),source=graph(roots,depth);
  const names=["transformed-state-validity","inverse-roundtrip","applicability-closure","raw-reconstruction","exact-legal-move-cardinality","exact-legal-move-bijection","unique-exact-move-mapping","transition-commutation","terminal-preservation","winner-equivariance","phase-semantics","pending-reserve-houseOwned-semantics","bounded-node-bijection","bounded-edge-bijection","adjacency-preservation"];
  const gates=Object.fromEntries(names.map((n)=>[n,0])),targetRoots=[];
  for(const root of roots){
    try{if(!T.applicable(root.state,id))gates["applicability-closure"]+=1;const t=T.transformState(root.state,id);if(!T.applicable(t,id))gates["applicability-closure"]+=1;targetRoots.push({...root,state:t});}
    catch{gates["transformed-state-validity"]+=1;}
  }
  const target=graph(targetRoots,depth),mappedNodes=new Set();
  for(const [key,state] of source.states){
    let t;
    try{t=T.transformState(state,id);R.assertStudyState(t);}catch{gates["transformed-state-validity"]+=1;continue;}
    mappedNodes.add(R.key(t));
    try{if(R.key(T.transformState(t,id))!==key)gates["inverse-roundtrip"]+=1;}catch{gates["inverse-roundtrip"]+=1;}
    if(!T.applicable(state,id)||!T.applicable(t,id))gates["applicability-closure"]+=1;
    try{R.project(t);}catch{gates["raw-reconstruction"]+=1;}
    if((state.winner!==null)!==(t.winner!==null))gates["terminal-preservation"]+=1;
    if(t.winner!==T.mappedWinner(state.winner,id))gates["winner-equivariance"]+=1;
    if(t.phase!==state.phase)gates["phase-semantics"]+=1;
    const sw=swaps(id);
    if(JSON.stringify(t.reserve)!==JSON.stringify(pair(state.reserve,sw))||JSON.stringify(t.houseOwned)!==JSON.stringify(pair(state.houseOwned,sw))||JSON.stringify(t.pending)!==JSON.stringify(pair(state.pending,sw)))gates["pending-reserve-houseOwned-semantics"]+=1;
    if(state.winner===null){
      const sm=E.moveVariants(state),mapped=sm.map((m)=>R.moveIdentity(T.transformMove(m,id))),tm=E.moveVariants(t).map(R.moveIdentity);
      if(mapped.length!==tm.length)gates["exact-legal-move-cardinality"]+=1;
      if(!setEqual(mapped,tm))gates["exact-legal-move-bijection"]+=1;
      if(new Set(mapped).size!==mapped.length||new Set(tm).size!==tm.length)gates["unique-exact-move-mapping"]+=1;
    }
  }
