  const generated = [];
  for (let seed = spec.population.seedBlock.start; seed <= spec.population.seedBlock.end; seed += 1) generated.push(trajectoryCandidate(seed, spec));

  const consumed=consumedIdentitySets(firewall,stage1);
  const oldSeeds=consumed.seeds, oldPrefixes=consumed.prefixes, oldRaw=consumed.raw;
  const excludedByFirewall = { trajectorySeed: 0, openingPrefixSha256: 0, rawStateKey: 0 };
  const eligibleRows = [];
  for (const row of generated) {
    if (row.unavailable) continue;
    let blocked = false;
    if (oldSeeds.has(row.seed)) { excludedByFirewall.trajectorySeed += 1; blocked = true; }
    if (oldPrefixes.has(row.openingPrefixSha256)) { excludedByFirewall.openingPrefixSha256 += 1; blocked = true; }
    if (oldRaw.has(row.stateKey)) { excludedByFirewall.rawStateKey += 1; blocked = true; }
    if (!blocked) eligibleRows.push(row);
  }

  eligibleRows.sort((a, b) => a.seed - b.seed);
  const selected = { namua: [], mtaji: [], "mtaji-houseless": [] };
  const usedPrefix = new Set();
  const usedRaw = new Set();
  for (const row of eligibleRows) {
    if (selected[row.stratum].length >= spec.population.targetRootsPerStratum) continue;
    if (usedPrefix.has(row.openingPrefixSha256) || usedRaw.has(row.stateKey)) continue;
    usedPrefix.add(row.openingPrefixSha256);
    usedRaw.add(row.stateKey);
    selected[row.stratum].push(row);
    if (Object.values(selected).every((rows) => rows.length >= spec.population.targetRootsPerStratum)) break;
  }

  const selectedRows = Object.values(selected).flat();
  const overlap = {
    trajectorySeed: selectedRows.filter((r) => oldSeeds.has(r.seed)).length,
    openingPrefixSha256: selectedRows.filter((r) => oldPrefixes.has(r.openingPrefixSha256)).length,
    rawStateKey: selectedRows.filter((r) => oldRaw.has(r.stateKey)).length,
  };
  const selectionLines = selectedRows.map((r) => `${r.stratum}|${r.seed}|${r.ply}|${r.openingPrefixSha256}|${r.stateKey}`);
  return {
    generated, selected, selectedRows, excludedByFirewall, selectedOverlap: overlap,
    selectionSha256: datasetHash(selectionLines),
    trajectoryGuardHitsBeforeSelection: generated.filter((r) => r.runtimeGuardHitBeforeSelection).length,
    internalUniquePrefixCount: new Set(selectedRows.map((r) => r.openingPrefixSha256)).size,
    internalUniqueRawCount: new Set(selectedRows.map((r) => r.stateKey)).size,
  };
}
function buildGraph(roots, depth) {
  const states = new Map(), levels = new Map(), queue = [], edges = new Map();
  let runtimeGuardHits = 0;
  function add(state, level) {
    R.assertStudyState(state);
    const key = R.stateKey(state);
    if (!states.has(key)) states.set(key, clone(state));
    if (!levels.has(key) || level < levels.get(key)) { levels.set(key, level); queue.push(key); }
    return key;
  }
  for (const root of roots) add(root.state, 0);
  while (queue.length) {
    const sourceKey = queue.shift();
    const level = levels.get(sourceKey);
    const state = states.get(sourceKey);
    if (state.winner !== null || level >= depth) continue;
    for (const move of E.moveVariants(state)) {
      const next = E.applyMove(state, move).state;
      if (next.reason === "relay-limit") { runtimeGuardHits += 1; continue; }
      const targetKey = add(next, level + 1);
      const moveKey = R.moveKey(move);
      edges.set(`${sourceKey}|${moveKey}|${targetKey}`, { sourceKey, targetKey, move: clone(move), moveKey });
    }
  }
  return { states, levels, edges, runtimeGuardHits };
}
function swapped(id) { return id === T.IDS.SEAT_SWAP || id === T.IDS.SEAT_SWAP_LR_MTAJI_HOUSELESS; }
function expectedPair(pair, swap) { return swap ? [pair[1], pair[0]] : [pair[0], pair[1]]; }

function measure(id, strata, selected, depth) {
  const roots = strata.flatMap((stratum) => selected[stratum]);
  const source = buildGraph(roots, depth);
  const names = [
    "transformed-state-validity","inverse-roundtrip","applicability-closure","raw-reconstruction",
    "exact-legal-move-cardinality","exact-legal-move-bijection","unique-exact-move-mapping",
    "transition-commutation","terminal-preservation","winner-equivariance","phase-semantics",
    "pending-reserve-houseOwned-semantics","bounded-node-bijection","bounded-edge-bijection","adjacency-preservation",
  ];
  const gates = Object.fromEntries(names.map((n) => [n, 0]));
  const targetRoots = [];
  for (const root of roots) {
    try {
      if (!T.applicable(root.state, id)) gates["applicability-closure"] += 1;
      const transformed = T.transformState(root.state, id);
      if (!T.applicable(transformed, id)) gates["applicability-closure"] += 1;
      targetRoots.push({ ...root, state: transformed });
